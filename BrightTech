<script>
  const assistantForm = document.getElementById('assistant-form');
  const assistantInput = document.getElementById('assistant-input');
  const assistantMessages = document.getElementById('assistant-messages');
  assistantForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const question = assistantInput.value.trim();
    if (!question) return;
    addAssistantMessage(question, 'user');
    assistantInput.value = '';
    const words = question.toLowerCase();
    let answer = 'I’m glad you reached out. I can help with services, products, prices, support, or contact details. What matters most to you right now?';
    if (words.includes('hello') || words.includes('hi') || words.includes('hey')) answer = 'Hello! It’s lovely to meet you. What kind of technology would make your work easier?';
    else if (words.includes('service') || words.includes('help')) answer = 'Absolutely, I can help with that. BrightTech provides IT support, hardware, software, networking, and cloud solutions for growing businesses.';
    else if (words.includes('price') || words.includes('cost') || words.includes('laptop')) answer = 'Our BrightBook Pro 14 laptop is $999. It’s a great fit for focused everyday work. You can compare the full range in the Products section.';
    else if (words.includes('product') || words.includes('monitor') || words.includes('router') || words.includes('printer')) answer = 'We offer laptops, monitors, routers, keyboards, SSDs, webcams, printers, and backup power units. Tell me what your team does and I can point you in the right direction.';
    else if (words.includes('support') || words.includes('quick') || words.includes('fast')) answer = 'I understand that interruptions are frustrating. Our average support response time is under 30 minutes during support hours.';
    else if (words.includes('contact') || words.includes('email') || words.includes('phone')) answer = 'Of course. Email hello@brighttech.co.za or call +27 11 555 0198, and a member of our human team will be happy to help.';
    addAssistantMessage('Maya is thinking…', 'bot typing');
    window.setTimeout(() => {
      const typingMessage = assistantMessages.querySelector('.typing');
      if (typingMessage) typingMessage.remove();
      addAssistantMessage(answer, 'bot');
    }, 650);
  });
  function addAssistantMessage(message, type) {
    const item = document.createElement('div');
    item.className = `assistant-message ${type}`;
